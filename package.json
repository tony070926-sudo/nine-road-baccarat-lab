{
  "name": "nine-road-baccarat-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build && npm run db:migrate:local",
    "test:e2e": "playwright test",
    "pretest:e2e:chromium": "npm run build && npm run db:migrate:local",
    "test:e2e:chromium": "playwright test --project=chromium",
    "serve:e2e": "wrangler pages dev dist --ip 127.0.0.1 --port 4173 --log-level warn --show-interactive-dev-session=false",
    "audit:probability": "tsx scripts/probability-audit.ts",
    "db:migrate:local": "wrangler d1 migrations apply nine-road-baccarat-leaderboard-preview --env preview --local",
    "release:preflight:preview": "node scripts/release-guard.mjs preview",
    "release:preflight:production": "node scripts/release-guard.mjs production",
    "db:migrate:preview": "node scripts/remote-migrations.mjs apply preview",
    "db:migrate:production": "node scripts/remote-migrations.mjs apply production",
    "db:verify:preview": "node scripts/remote-migrations.mjs verify preview",
    "db:verify:production": "node scripts/remote-migrations.mjs verify production",
    "deploy:preview": "node scripts/deploy-pages.mjs preview",
    "deploy:production": "node scripts/deploy-pages.mjs production",
    "smoke:leaderboard": "node scripts/smoke-leaderboard.mjs",
    "check:release": "node scripts/check-release-contract.mjs",
    "check:wrangler-types": "node scripts/check-wrangler-types.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:functions": "npm run check:release && npm run check:wrangler-types && wrangler types --include-runtime=false --check functions/types.d.ts && tsc -p functions/tsconfig.json && wrangler pages functions build functions --outdir .wrangler/functions-check --project-directory .",
    "check": "npm run check:architecture && npm run check:functions && npm run lint && npm run test:coverage && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
